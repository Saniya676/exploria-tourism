# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=exploria_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
