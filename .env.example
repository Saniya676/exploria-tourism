# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweather_api_key_here

# Optional AI Provider (Gemini / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
